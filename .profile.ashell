export EDITOR=vim
export XDG_CONFIG_HOME=$HOME/Documents/.config

# For dash
export PS1='$(echo "\\033[48;2;76;86;106m") $PWD $(echo "\\033[m\\033[38;2;76;86;106m\\033[m ")'

alias view="vim -RM"
alias vi="vim"

alias ll="ls -lh"
alias la="ls -lah"

alias grep="rg"

config -s 14 -n 'SFMono Nerd Font'
config -f "#eeffff" -b "#212121"
